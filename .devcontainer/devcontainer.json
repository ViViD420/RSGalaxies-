{
  "name": "RS Galaxies Go + Godot workspace",
  "image": "mcr.microsoft.com/devcontainers/go:1-1.23-bookworm",
  "customizations": {
    "vscode": {
      "extensions": [
        "golang.go",
        "geequlim.godot-tools",
        "ms-azuretools.vscode-docker"
      ],
      "settings": {
        "go.testFlags": ["-race"],
        "editor.formatOnSave": true,
        "[go]": { "editor.defaultFormatter": "golang.go" }
      }
    }
  },
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "RS Galaxies development API",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "cd server && go mod download && go test ./... && go vet ./..."
}
