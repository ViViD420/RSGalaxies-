# Local development defaults only. Replace credentials before any shared environment.
RS_GALAXIES_ENV=development
RS_GALAXIES_ADDR=:8080
RS_GALAXIES_DATABASE_URL=postgres://rsgalaxies:rsgalaxies-dev-only@localhost:5432/rsgalaxies?sslmode=disable
RS_GALAXIES_TEST_DATABASE_URL=postgres://rsgalaxies:rsgalaxies-dev-only@localhost:5432/rsgalaxies_test?sslmode=disable
RS_GALAXIES_ALLOWED_ORIGINS=http://localhost:8000
RS_GALAXIES_ENABLE_REGISTRATION=true
